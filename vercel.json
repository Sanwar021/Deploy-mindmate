{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd software && npm install",
  "buildCommand": "cd software && npm run build",
  "outputDirectory": "software/dist",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "{software/server/**,pilot/real-results/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
