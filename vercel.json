{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd software && npm install",
  "buildCommand": "cd software && npm run build",
  "outputDirectory": "software/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{software/server/**,pilot/real-results/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs?__path=$1"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
